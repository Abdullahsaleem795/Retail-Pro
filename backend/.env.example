NODE_ENV=development
PORT=5000

# Supabase Postgres connection string.
# Use the POOLER host, not db.<ref>.supabase.co - Supabase's direct host is
# IPv6-only, and most hosts/networks have no outbound IPv6 route, so a direct
# connection just times out (ENOTFOUND/ENODATA).
# Get from: Supabase Dashboard > Settings > Database > Connection Pooling
# (choose "Session" mode, port 5432 - this is a long-running server, not
# serverless, so a normal session connection is correct).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Schema all RetailPro tables live in. Only override this for tests
# (tests/env.js sets it to retailpro_test automatically).
DB_SCHEMA=retailpro

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS - comma-separated list of allowed frontend origins
# e.g. http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# WhatsApp Cloud API (leave blank to log messages instead of sending)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Set to true on extra replicas so cron jobs only run on one instance
DISABLE_SCHEDULER=false

# wa.me deep-link target for subscription upgrade requests / supplier orders
# (defaults to 923056779779 in code if unset)
ADMIN_WHATSAPP=923xxxxxxxxx

# SMTP credentials for the platform-admin email notification sent when a shop
# submits a Pro/Enterprise upgrade request (see emailService.js). Leave blank
# to log instead of sending. The recipient address itself is NOT set here -
# it's entered by the admin in the Platform Console (Payment Accounts ->
# Notification Email), stored in platform_payment_accounts.notify_email.
# Example for Gmail: host smtp.gmail.com, port 587, user your gmail address,
# pass a 16-character Google App Password (not your normal password).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Platform-operator (SaaS owner) console. Required to use /api/admin/* -
# activating a shop's paid subscription, viewing all shops across tenants.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER share this key with shop owners - it is what gates real billing
# activation, replacing the old self-service /subscription/activate endpoint.
PLATFORM_ADMIN_KEY=

# Vercel Cron Jobs auth (see vercel.json "crons" + src/routes/cronRoutes.js).
# On Vercel, set the SAME value as a project env var named CRON_SECRET -
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` on its own
# cron invocations, which this endpoint verifies. Required because
# node-cron/startScheduler() cannot run on serverless - these HTTP endpoints
# are the real fix, not a workaround.
CRON_SECRET=
