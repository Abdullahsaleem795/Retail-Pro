NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/retailpro?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
CLIENT_URL=http://localhost:5173

# WhatsApp Cloud API (leave blank to log messages instead of sending)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Set to true on extra replicas so cron jobs only run on one instance
DISABLE_SCHEDULER=false
