{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    { "path": "/api/cron/low-stock", "schedule": "0 3 * * *" },
    { "path": "/api/cron/daily-report", "schedule": "0 16 * * *" },
    { "path": "/api/cron/weekly-report", "schedule": "0 16 * * 0" }
  ]
}
